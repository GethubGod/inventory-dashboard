# ── Environment ────────────────────────────────────────────
# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ── Square OAuth (required for Square integration) ─────────
NEXT_PUBLIC_SQUARE_APP_ID=sq0idp-your-app-id
NEXT_PUBLIC_SQUARE_AUTHORIZE_URL=https://connect.squareup.com/oauth2/authorize
SQUARE_APP_SECRET=sq0csp-your-app-secret
SQUARE_API_BASE_URL=https://connect.squareup.com

# ── Optional ───────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=  # Server-only. NEVER prefix with NEXT_PUBLIC_
